{
  "name": "OPENWORKS 2.0",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "FORGE": {
        "$path": "src/ReplicatedStorage/FORGE"
      },
      "OpenWorks": {
        "$path": "src/ReplicatedStorage/OpenWorks"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "FORGE": {
        "$path": "src/ServerScriptService/FORGE"
      },
      "Services": {
        "$path": "src/ServerScriptService/Services"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "FORGE": {
          "$path": "src/StarterPlayerScripts/FORGE"
        },
        "Controllers": {
          "$path": "src/StarterPlayerScripts/Controllers"
        }
      }
    }
  }
}
